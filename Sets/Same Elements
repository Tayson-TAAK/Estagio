public Boolean sameElements(List<Integer> nums1, List<Integer> nums2) {
    Set<Integer> nums1SemDuplicatas = new Set<Integer>();
    Set<Integer> nums2SemDuplicatas = new Set<Integer>();
    nums1SemDuplicatas.addAll(nums1);
    nums2SemDuplicatas.addAll(nums2);

    for(Integer n : nums1SemDuplicatas){
        if(nums2SemDuplicatas.contains(n) == false){
            return false;
        }
    }
    for(Integer n : nums2SemDuplicatas){
        if(nums1SemDuplicatas.contains(n) == false){
            return false;
        }
    }
    return true;
}