public Map<String, List<Case>> casesByType(List<Case> cases) {
    Map<String, List<Case>> myMap = new Map<String, List<Case>>();

    for(Case c : cases){
        if(c.Type != null){
            if(myMap.containsKey(c.Type)){  
                myMap.get(c.Type).add(c);
            } else {
                myMap.put(c.Type, new List<Case>{c});
            }
        }
    }
    return myMap;
}