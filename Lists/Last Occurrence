public static Integer findLast(List<Integer> nums, Integer target) {
    Integer ultimoIndice = 0;
    if(nums.indexOf(target) != -1){
        for(Integer i = 0; i <nums.size(); i++){
            if(nums[i] == target){
                ultimoIndice = i;
            }
        }
        return ultimoIndice;
    }
    return -1;
}