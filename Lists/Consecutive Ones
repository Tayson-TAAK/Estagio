public Integer maxConsecutiveOnes(Integer[] numbers) {
    if(numbers.isEmpty()){
        return 0;
    } else {
        List<Integer> maioresValores = new List<Integer>();
        Integer contador = 0;

        for(Integer i = 0; i < numbers.size(); i++){
            if(numbers[i] == 1){
                contador++;
            } else {
                contador = 0;
            }
            maioresValores.add(contador);
        }

        maioresValores.sort();
        return maioresValores[maioresValores.size()-1];
    }
}