public List<apxio__Student__c> selectUnreachableStudents() {
    List<apxio__Student__c> estudantesInacessiveis = [
        select Id, Name
        from apxio__Student__c
        where (
            apxio__Active__c = true AND 
            apxio__Email__c = null AND 
            apxio__Phone__c = null
        )
        ORDER BY Name
    ];

    return estudantesInacessiveis;
}