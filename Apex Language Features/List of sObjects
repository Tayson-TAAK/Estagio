public List<sObject> getListOfsObject(List<Account> accounts, List<Contact> contacts){
    List<SObject> objetos = new List<SObject>();
    
    if(accounts == null && contacts == null){
        return objetos;
    }
    
    if(accounts != null){
        for(Account acc : accounts){
            objetos.add(acc);
        }
    }
    
    if(contacts != null){
        for(Contact contato : contacts){
            objetos.add(contato);
        }
    }

    return objetos;
}