public class LinkedList{
    Node head;
    Node tail;
    Integer size;

    public LinkedList(){
        this.head = null;
        this.tail = null;
        this.size = 0;
    }
    
    public void addToFront(Integer value){
        Node newNode = new Node(value);
        
        if(this.head == null){
            this.head = newNode;
            this.tail = this.head;
        } else {
            newNode.next = this.head;
            this.head = newNode;
        }
        this.size++;
    }

    public Integer removeFromFront(){
        if(this.size == 0) {
            return null;
        } else {
            Node remove = this.head;
            this.head = this.head.next;
            this.size--;
            return remove.data;
        }
    }

    public void addToTail(Integer value){
        Node newNode = new Node(value);

        if(this.head == null){
            this.head = newNode;
            this.tail = this.head;
        }else{
            this.tail.next = newNode;
            this.tail = newNode;
        }
        this.size++;
    }

    public Integer removeFromTail(){
        if(this.size == 0) {
            return null;
        } else {
            if(this.size == 1){
                Node temp = this.head;
                this.head = null;
                this.size--;
                return temp.data;
            }
            Node atual = this.head;
            Node newTail = null;

            while(atual.next != null){
                newTail = atual;
                atual = atual.next;
            }
            this.tail = newTail;
            this.tail.next = null;
            this.size--;
            return atual.data;
        }
    }

    public Integer size(){ return this.size;}    
}

public class Node{
    Integer data;
    Node next;

    public Node(Integer data){
        this.data = data;
    }
}