public List<Integer> twoSum(List<Integer> nums, Integer target){
    Integer soma = 0;
    Integer right = nums.size()-1;

    for (Integer left = 0; left < nums.size();) {
        soma = nums[left] + nums[right];
        
        if(soma == target){
            return new List<Integer>{left, right};
        } else if(soma > target) {
            right--;
        } else {
            left++;
        }
    }

    return null;
}