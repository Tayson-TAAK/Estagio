public static List<Integer> twoSum(List<Integer> nums, Integer target) {
    Map<Integer, Integer> indexMap = new Map<Integer, Integer>();

    for (Integer i = 0; i < nums.size(); i++) {
        Integer numAtual = nums[i];
        Integer diferenca = target - numAtual;

        if (indexMap.containsKey(diferenca)) {
            return new List<Integer>{ indexMap.get(diferenca), i };
        }
        indexMap.put(numAtual, i);
    }
    return null;
}